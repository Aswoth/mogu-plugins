#!date=2026-10-02 13:57:49

[Rule]
AND, ((IP-CIDR, 101.126.58.201/32, no-resolve), (DEST-PORT, 6443)), REJECT
AND, ((IP-CIDR, 110.249.199.75/32, no-resolve), (DEST-PORT, 6443)), REJECT
AND, ((IP-CIDR, 111.225.147.191/32, no-resolve), (DEST-PORT, 6443)), REJECT
AND, ((IP-CIDR, 111.63.61.101/32, no-resolve), (DEST-PORT, 6443)), REJECT
AND, ((IP-CIDR, 220.243.141.0/32, no-resolve), (DEST-PORT, 6443)), REJECT

AND, ((OR, ((DOMAIN-SUFFIX, bytegecko.com), (DOMAIN-SUFFIX, byteeffecttos.com))), (DOMAIN-KEYWORD, ncdn)), REJECT
AND, ((DOMAIN-KEYWORD, tnc), (OR, ((DOMAIN-SUFFIX, capcutapi.com), (DOMAIN-SUFFIX, zijieapi.com), (DOMAIN-SUFFIX, isnssdk.com), (DOMAIN-SUFFIX, toutiaoapi.com), (DOMAIN-SUFFIX, bytedance.com), (DOMAIN-SUFFIX, snssdk.com), (DOMAIN-SUFFIX, sgsnssdk.com)))), DIRECT
AND, ((DOMAIN-KEYWORD, -ad-), (DOMAIN-SUFFIX, byteimg.com)), REJECT
AND, ((DOMAIN-KEYWORD, ads), (DOMAIN-KEYWORD, -normal.zijieapi.com)), REJECT
DOMAIN, lf-ad-ies.bytecdn.cn, REJECT
DOMAIN, dig.bdurl.net, REJECT
DOMAIN, extlog.snssdk.com, REJECT
DOMAIN, mcs.snssdk.com, REJECT
DOMAIN-SUFFIX, bds.snssdk.com, REJECT
DOMAIN-SUFFIX, byteadverts.com, REJECT
DOMAIN-SUFFIX, ctobsnssdk.com, REJECT
DOMAIN-SUFFIX, pangle.io, REJECT
DOMAIN-KEYWORD, pangolin, REJECT
DOMAIN-KEYWORD, pglstatp, REJECT
DOMAIN-KEYWORD, panplayable-toutiao, REJECT
DOMAIN-KEYWORD, -ad-sign.byteimg.com, REJECT
DOMAIN-KEYWORD, -ad.byteoversea.com, REJECT
DOMAIN-KEYWORD, asiad.byteactivity, REJECT

[Rewrite]
request if ${url} ~= /^https:\/\/api5-normal-lq\.amemv\.com\/api\/ad\//i then reject(404)
request if ${url} ~= /^https:\/\/(aweme\.snssdk\.com|api5-normal-m\.amemv\.com)\/api\/ad\//i then reject(404)
request if ${url} ~= /^https:\/\/zlink\.ugsdk\.cn\/ad\//i then reject(404)

response if ${url} ~= /^https:\/\/((aweme\.snssdk\.com|api5-normal-m\.amemv\.com)|api5-normal-m\.amemv\.com)\/aweme\/homepage\/sidebar_data\/\?/i then response.json.delete(["data_map.recently_apps", "data_map.recently_users"])


response if ${url} ~= /^https:\/\/(aweme\.snssdk\.com|api5-normal-m\.amemv\.com)\/aweme\/homepage\/render\/\?/i then response.json.delete("data.tab_config")

response if ${url} ~= /^https:\/\/(aweme\.snssdk\.com|api5-normal-m\.amemv\.com)\/aweme\/homepage\/render\/\?/i then response.json.jq(".data.tab_list[]? |= (if .extra.side_bar.modules != null then .extra.side_bar.modules[]?.items[]? |= (if .data.first_page_module?.module_title == \"常用功能\" then .data={} else . end) else . end) | .data.tab_list |= map(if .extra.tab_list != null then .extra.tab_list |= map(select(.tab_id | IN(\"homepage_tablive\", \"homepage_follow\", \"homepage_hot_container\"))) else . end) | .data.tab_list |= map(select(.extra.tab_list != null and (.extra.tab_list | length > 0)))")

response if ${url} ~= /^https:\/\/(aweme\.snssdk\.com|api5-normal-m\.amemv\.com)\/tfe\/api\/request_combine\/v1\/\?need_personal_recommend/i then response.json.replace(["data[\"/service/settings/v3/\"].body.data.settings.homepage_two_session_tab_skin_2025", "data[\"/service/settings/v3/\"].body.data.settings.homepage_tab_skin_enable"], [false, false])
request if ${url} ~= /^https?:\/\/api-access\.pangolin-sdk-toutiao\.com\/api\/ad\/union\/sdk/i then reject(404)
request if ${url} ~= /^https?:\/\/toblog\.ctobsnssdk\.com/i then reject(200)

[MitM]
hostname=aweme.snssdk.com, api5-normal-m.amemv.com, api-access.pangolin-sdk-toutiao*.com, api-access.pangolin-sdk-toutiao.com, ether-pack.pangolin-sdk-toutiao.com, gromore.pangolin-sdk-toutiao.com, lfd?-analytics.bytescm.com, lfd?-cdn-tos.bytescm.com, sfd?-fe-tos.pglstatp-toutiao.com, toblog.ctobsnssdk.com
#!date=2026-10-02 13:57:49

[Rule]
DOMAIN, zlink.ugsdk.cn, REJECT
DOMAIN, mon.toutiaocloud.net, REJECT
DOMAIN, lf-normal-gr-sourcecdn.bytegecko.com, REJECT
DOMAIN, lf-webcast-gr-sourcecdn.bytegecko.com, REJECT
DOMAIN, p3-developer.bytemaimg.com, REJECT
DOMAIN, webcast-open.douyin.com, REJECT
DOMAIN, p11-webcast-sign.douyinpic.com, REJECT
DOMAIN, p3-webcast-sign.douyinpic.com, REJECT
DOMAIN, log3-applog.fqnovel.com, REJECT
DOMAIN, log5-applog.fqnovel.com, REJECT
DOMAIN, mon11-misc-lq.fqnovel.com, REJECT
DOMAIN, mon11-misc.fqnovel.com, REJECT
DOMAIN, mon3-misc.fqnovel.com, REJECT
DOMAIN, rtlog3-applog.fqnovel.com, REJECT
DOMAIN, rtlog5-applog.fqnovel.com, REJECT
DOMAIN, effect.snssdk.com, REJECT
DOMAIN, i.snssdk.com, REJECT
DOMAIN, is-lq.snssdk.com, REJECT
DOMAIN, is.snssdk.com, REJECT
DOMAIN, security.snssdk.com, REJECT
DOMAIN, vas.snssdk.com, REJECT
DOMAIN, mon.toutiaocloud.com, REJECT
DOMAIN, abtest3-misc.zijieapi.com, REJECT
DOMAIN, ads3-normal.zijieapi.com, REJECT
DOMAIN, ads5-normal.zijieapi.com, REJECT
DOMAIN, feedback-c.zijieapi.com, REJECT
DOMAIN, gecko3.zijieapi.com, REJECT
DOMAIN, gecko5.zijieapi.com, REJECT
DOMAIN, ma.zijieapi.com, REJECT
DOMAIN, minigame3-normal.zijieapi.com, REJECT
DOMAIN, minigame5-normal.zijieapi.com, REJECT
DOMAIN, mssdk.zijieapi.com, REJECT
DOMAIN, timon.zijieapi.com, REJECT
DOMAIN, vcs.zijieapi.com, REJECT
AND, ((DOMAIN-KEYWORD, tnc), (OR, ((DOMAIN-SUFFIX, capcutapi.com), (DOMAIN-SUFFIX, zijieapi.com), (DOMAIN-SUFFIX, isnssdk.com), (DOMAIN-SUFFIX, toutiaoapi.com), (DOMAIN-SUFFIX, bytedance.com), (DOMAIN-SUFFIX, snssdk.com), (DOMAIN-SUFFIX, sgsnssdk.com)))), DIRECT
AND, ((DOMAIN-KEYWORD, -ad-), (DOMAIN-SUFFIX, byteimg.com)), REJECT
AND, ((DOMAIN-KEYWORD, ads), (DOMAIN-KEYWORD, -normal.zijieapi.com)), REJECT
DOMAIN, lf-ad-ies.bytecdn.cn, REJECT
DOMAIN, dig.bdurl.net, REJECT
DOMAIN, extlog.snssdk.com, REJECT
DOMAIN, mcs.snssdk.com, REJECT
DOMAIN-SUFFIX, bds.snssdk.com, REJECT
DOMAIN-SUFFIX, byteadverts.com, REJECT
DOMAIN-SUFFIX, ctobsnssdk.com, REJECT
DOMAIN-SUFFIX, pangle.io, REJECT
DOMAIN-KEYWORD, pangolin, REJECT
DOMAIN-KEYWORD, pglstatp, REJECT
DOMAIN-KEYWORD, panplayable-toutiao, REJECT
DOMAIN-KEYWORD, -ad-sign.byteimg.com, REJECT
DOMAIN-KEYWORD, -ad.byteoversea.com, REJECT
DOMAIN-KEYWORD, asiad.byteactivity, REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/api-access\.pangolin-sdk-toutiao\.com\/api\/ad\/union\/sdk/i then reject(404)
request if ${url} ~= /^https?:\/\/toblog\.ctobsnssdk\.com/i then reject(200)

[MitM]
hostname=api-access.pangolin-sdk-toutiao*.com, api-access.pangolin-sdk-toutiao.com, ether-pack.pangolin-sdk-toutiao.com, gromore.pangolin-sdk-toutiao.com, lfd?-analytics.bytescm.com, lfd?-cdn-tos.bytescm.com, sfd?-fe-tos.pglstatp-toutiao.com, toblog.ctobsnssdk.com
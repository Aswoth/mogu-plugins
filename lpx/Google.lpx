#!name=Google搜索重定向
#!desc=将Google搜索重定向至.com域名，如遇频繁跳转请禁用本插件。
#!openUrl=
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Google.png
#!date=2026-10-02 13:57:49

[Rewrite]
request if ${url} ~= /^https?:\/\/(www.)?(g|google)\.cn/i then redirect(307, "https://www.google.com")
request if ${url} ~= /^https?:\/\/(ditu|maps).google\.cn/i then redirect(307, "https://maps.google.com")

[Rule]
DOMAIN, app-analytics-services.com, REJECT
DOMAIN, odm.app-ads-services.com, REJECT
DOMAIN, firebaselogging-pa.googleapis.com, REJECT
DOMAIN, firebaseinappmessaging.googleapis.com, REJECT
DOMAIN, fundingchoicesmessages.google.com, REJECT
DOMAIN-SUFFIX, doubleclick.net, REJECT
DOMAIN-SUFFIX, doubleclick-cn.net, REJECT
DOMAIN-SUFFIX, googlesyndication.com, REJECT
DOMAIN-SUFFIX, googlesyndication-cn.com, REJECT

[MitM]
hostname=www.google.cn
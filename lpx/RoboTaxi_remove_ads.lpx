[Rewrite]
request if ${url} ~= /^https:\/\/idgdata\.baidu\.com\/mc\/app\/api\/listterminal\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/idgdata\.baidu\.com\/operation\/api\/announce\/screen\/image_manage\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/idgdata\.baidu\.com\/idgactivity\/api\/newuser\/info\?/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/mobads-pre-config\.cdn\.bcebos\.com\/preload\.php/i then reject(200)


[Rewrite]
request if ${url} ~= /^https:\/\/m\.qianbao\.qq\.com\/services\/walletHome\/getQQshopData\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/m\.qianbao\.qq\.com\/services\/walletHome\/getGameData\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/m\.qianbao\.qq\.com\/services\/walletHome\/getFootData\?/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/us\.l\.qq\.com\/exapp/i then reject(200)
request if ${url} ~= /^https:\/\/api\.xiangji\.qq\.com\/splash$/i then reject_dict(200)

[MitM]
hostname=m.qianbao.qq.com, us.l.qq.com, api.xiangji.qq.com
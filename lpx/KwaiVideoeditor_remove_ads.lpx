#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/KwaiVideoeditor.png
#!date=2026-10-02 13:57:49

[Rewrite]
request if ${url} ~= /^https:\/\/api\.kmovie\.gifshow\.com\/rest\/n\/kmovie\/app\/resource\/get\?/i then reject_dict(200)

response if ${url} ~= /^https:\/\/api\.kmovie\.gifshow\.com\/rest\/n\/kmovie\/app\/banner\/common\/getBannerByTypeV2\?/i then response.json.jq("del(.list[] | select(.bannerChannelName == \"活动\"))")
response if ${url} ~= /^https:\/\/api\.kmovie\.gifshow\.com\/rest\/n\/kmovie\/app\/banner\/common\/getAllBannerPage\?/i then response.json.jq("del(.data[] | select(.bannerChannelName == \"活动\"))")

request if ${url} ~= /^https:\/\/api\.kmovie\.gifshow\.com\/rest\/n\/kmovie\/app\/banner\/common\/getBannerByType\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/api\.kmovie\.gifshow\.com\/rest\/n\/kmovie\/app\/merchant\/ad\//i then reject_dict(200)

request if ${url} ~= /^https:\/\/api\.kmovie\.gifshow\.com\/rest\/n\/kmovie\/app\/resource\/activity\/pendant\?/i then reject_dict(200)

[Rule]
DOMAIN, gdfp.gifshow.com, REJECT
DOMAIN, open.e.kuaishou.com, REJECT
DOMAIN, open.e.kuaishou.cn, REJECT
DOMAIN, adtrack.e.kuaishou.com, REJECT
DOMAIN-SUFFIX, partner.gifshow.com, REJECT
DOMAIN-SUFFIX, adukwai.com, REJECT
DOMAIN-SUFFIX, adkwai.com, REJECT
DOMAIN, cdndns.kwd.inkuai.com, REJECT
DOMAIN, hdns.k-dyn.com, REJECT
DOMAIN, kuaishou.httpdns.pro, REJECT
DOMAIN, httpdns.kwd.inkuai.com, REJECT
DOMAIN, apidns.kwd.inkuai.com, REJECT
DOMAIN, apidns-js.kwd.inkuai.com, REJECT

[MitM]
hostname=api.kmovie.gifshow.com
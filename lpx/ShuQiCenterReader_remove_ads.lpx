[Rule]
DOMAIN, render-web.11222.cn, REJECT
DOMAIN, ossgw.alicdn.com, REJECT
DOMAIN, ems.youku.com, REJECT
DOMAIN, hudong.alicdn.com, REJECT
DOMAIN, et.tanx.com, REJECT
DOMAIN, df.tanx.com, REJECT
DOMAIN, opehs.tanx.com, REJECT
DOMAIN, beacon-api.aliyuncs.com, REJECT
DOMAIN, adash.man.aliyuncs.com, REJECT
DOMAIN, adashx.m.taobao.com, REJECT
DOMAIN, applog.uc.cn, REJECT
DOMAIN, atoken.m.taobao.com, REJECT
AND, ((DOMAIN-KEYWORD, adash), (DOMAIN-SUFFIX, ut.taobao.com)), REJECT
DOMAIN, baichuan-sdk.alicdn.com, REJECT
DOMAIN, acs4baichuan.m.taobao.com, REJECT
DOMAIN, nbsdk-baichuan.alicdn.com, REJECT
DOMAIN, api.sm.cn, REJECT
DOMAIN, c.sm.cn, REJECT
DOMAIN, content-understand-strategy.sm.cn, REJECT
DOMAIN, hc-ssp.sm.cn, REJECT
DOMAIN, sdk-log.partner.sm.cn, REJECT
DOMAIN, partner.uc.cn, REJECT
DOMAIN, cpc-service-square.aiclk.com, REJECT
DOMAIN, logrcv.aiclk.com, REJECT
DOMAIN, acjs.aliyun.com, REJECT
DOMAIN, retcode.alicdn.com, REJECT
DOMAIN, arms-retcode.aliyuncs.com, REJECT
DOMAIN, huichuan.sm.cn, REJECT
DOMAIN, huichuan-mc.sm.cn, REJECT
DOMAIN, httpdns.alicdn.com, REJECT
DOMAIN, httpdns-api.aliyuncs.com, REJECT
DOMAIN, httpdns-sc.aliyuncs.com, REJECT
IP-CIDR, 203.107.1.0/24, REJECT, no-resolve
DOMAIN, amdc.alipay.com, REJECT
DOMAIN, ucdc.upaas.quark.cn, REJECT
DOMAIN, httpdns.danuoyi.tbcache.com, REJECT
URL-REGEX, "^http:\/\/amdc\.m\.taobao\.com\/amdc\/mobileDispatch", REJECT
URL-REGEX, "^http:\/\/47\.246\.103\.9\/amdc\/mobileDispatch", REJECT
URL-REGEX, "^http:\/\/47\.246\.103\.10\/amdc\/mobileDispatch", REJECT
URL-REGEX, "^http:\/\/59\.82\.113\.10\/amdc\/mobileDispatch", REJECT
URL-REGEX, "^http:\/\/59\.82\.113\.219\/amdc\/mobileDispatch", REJECT
DOMAIN, xpis-xcdn.youku.com, REJECT
DOMAIN, pre-xpis-xcdn.youku.com, REJECT
DOMAIN, xpis-tel-xcdn.youku.com, REJECT
DOMAIN, xpis-mob-xcdn.youku.com, REJECT

[Rewrite]
request if ${url} ~= /^https:\/\/huichuan\.sm\.cn\/nativead/i then reject_dict(200)

request if ${url} ~= /^https:\/\/ocean\.shuqireader\.com\/api\/route\/iosReadPage\/adV2/i then reject_dict(200)
request if ${url} ~= /^https:\/\/ocean\.shuqireader\.com\/api\/route\/ios\/readPage$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/ocean\.shuqireader\.com\/api\/render\/load\/resource/i then reject(404)
request if ${url} ~= /^https:\/\/ucdc\d?-upaas\.uc\.cn\/api\/v\d\/dns_query\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/gw\.alicdn\.com\/mt\//i then reject(404)
request if ${url} ~= /^https:\/\/gw\.alicdn\.com\/tfs\/.+\d{3,4}-\d{4}/i then reject(404)
request if ${url} ~= /^https:\/\/gw\.alicdn\.com\/tps\/.+\d{3,4}-\d{4}/i then reject(404)
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.taobao\.idle\.home\.welcome/i then reject(404)
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.film\.mtopadvertiseapi\.queryloadingbanner\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.film\.life\.popup\.get\//i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/ocean\.shuqireader\.com\/sqios\/render\/render\/page\/bookstore$/i then script("https://kelee.one/Resource/JavaScript/ShuQiCenterReader/ShuQiCenterReader_remove_ads.js") with tag="移除书城横幅和阅读广告", requires_body=true

[MitM]
hostname=ocean.shuqireader.com, huichuan.sm.cn, ucdc2-upaas.uc.cn, acs.m.goofish.com, acs.m.taobao.com, gw.alicdn.com, iyes.youku.com